#Pobranie modelu
#Tworzymy folder, pobieramy model i nadajemy mu uprawnienia do uruchamiania:
sudo mkdir -p /opt/llamafile
sudo curl -L -o /opt/llamafile/model.llamafile "https://huggingface.co/jartine/TinyLlama-1.1B-Chat-v1.0-GGUF/resolve/main/TinyLlama-1.1B-Chat-v1.0.Q4_K_M.llamafile"
sudo chmod +x /opt/llamafile/model.llamafile

#Konfiguracja konta i uprawnień
#Tworzymy użytkownika i od razu katalog domowy, a następnie przypisujemy uprawnienia:
sudo useradd --system --no-create-home --shell /bin/false llamafile
sudo chown -R llamafile:llamafile /opt/llamafile
sudo mkdir -p /home/llamafile
sudo chown llamafile:llamafile /home/llamafile

#Utworzenie pliku usługi systemd
#Otwieramy edytor tekstu:
sudo nano /etc/systemd/system/llamafile.service

#Wklejamy do niego tę zawartość
[Unit]
Description=Llamafile HTTP REST API Service
After=network-online.target
Wants=network-online.target

[Service]
User=llamafile
Group=llamafile
WorkingDirectory=/opt/llamafile
ExecStart=/bin/sh /opt/llamafile/model.llamafile --server --nobrowser --host 192.168.X.X --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

#Uruchomienie usługi
#Przeładowujemy konfigurację i włączamy usługę na stałe:
sudo systemctl daemon-reload
sudo systemctl enable --now llamafile

#Zbieranie wyników
#Wywołujemy komendy potrzebne do skopiowania do dokumentacji
sudo systemctl status llamafile
sudo ss -tlnp | grep 8080
ps aux | grep llamafile

#Wysłanie zapytania z gospodarza
#W osobnym oknie na Macu wysyłamy żądanie do API
curl -X POST http://192.168.X.X:8080/v1/chat/completions \
-H "Content-Type: application/json" \
-d '{
  "model": "gpt-3.5-turbo",
  "messages": [{"role": "user", "content": "Napisz jedno zdanie."}],
  "temperature": 0.3
}'


